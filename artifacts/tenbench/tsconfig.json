{
  "extends": "../../tsconfig.base.json",
  "include": ["next-env.d.ts", "app/**/*", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "src", "build", "dist", "out", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "@/*": ["./app/*"]
    }
  }
}
